# Full public URL of the site — no trailing slash.
# Used for canonical links, sitemap, and robots.txt.
# In production, set this as a runtime environment variable.
PUBLIC_BASE_URL=http://localhost:5173

# Display name — appears in browser tab titles as "Page | PUBLIC_SITE_NAME".
PUBLIC_SITE_NAME=skeletoni

# --- Shiplight (E2E) ---
# Only needed for AI-resolved steps (DRAFT / bare VERIFY). Fully-enriched tests
# (action + locator, VERIFY + js) replay deterministically without a token.
# SHIPLIGHT_API_TOKEN=
# Or a provider key instead: GOOGLE_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY
