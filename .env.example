# Full public URL of the site — no trailing slash.
# Used for canonical links, sitemap, and robots.txt.
# In production, set this as a runtime environment variable.
PUBLIC_BASE_URL=http://localhost:5173

# Display name — appears in browser tab titles as "Page | PUBLIC_SITE_NAME".
PUBLIC_SITE_NAME=skeletoni

# --- Shiplight (E2E) ---
# The fixture requires a model to be *named*, but our tests are fully enriched
# (action + locator, VERIFY + js) and replay deterministically — no API call,
# no key needed. CI copies this file to .env, so a name alone keeps CI green.
WEB_AGENT_MODEL=claude-haiku-4-5
# Only needed if you author AI-resolved steps (DRAFT / bare VERIFY) or a JS cache
# fails and self-heals. Then add a token/key matching the model above:
# SHIPLIGHT_API_TOKEN=
# GOOGLE_API_KEY= / ANTHROPIC_API_KEY= / OPENAI_API_KEY=
