{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "github>lkshrk/gh-ops//renovate/presets/github-actions.json5"],
	"dependencyDashboard": true,
	"prConcurrentLimit": 10,
	"automerge": true,
	"automergeType": "pr",
	"platformAutomerge": true,
	"labels": ["dependencies"],
	"internalChecksFilter": "strict",
	"packageRules": [
		{
			"matchDepNames": ["@sveltejs/kit", "@sveltejs/adapter-node"],
			"groupName": "SvelteKit and Node adapter"
		},
		{
			"matchDatasources": ["npm"],
			"minimumReleaseAge": "3 days"
		},
		{
			"matchDepNames": ["typescript"],
			"allowedVersions": "<7"
		},
		{
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true
		},
		{
			"matchUpdateTypes": ["major"],
			"automerge": true,
			"minimumReleaseAge": "3 days"
		}
	]
}
